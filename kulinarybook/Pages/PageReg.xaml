<Page x:Class="kulinarybook.Pages.PageReg"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:kulinarybook.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageReg">

    <Grid Margin="36,-167,-30,0" Height="498" VerticalAlignment="Top" RenderTransformOrigin="0.491,-0.237">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform/>
                <SkewTransform/>
                <RotateTransform Angle="0"/>
                <TranslateTransform/>
            </TransformGroup>
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.Background>
            <ImageBrush ImageSource="/Pages/i (7).png"/>
        </Grid.Background>
        <TextBlock HorizontalAlignment="Left" Margin="299,218,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Foreground="#FF630803" FontSize="24" Width="260" FontFamily="Yu Gothic UI" Height="26" RenderTransformOrigin="0.613,0.375" FontWeight="Bold" FontStyle="Italic"><Run Language="ru-ru" Text="РЕГИСТРАЦИЯ"/></TextBlock>
        <TextBlock HorizontalAlignment="Left" Margin="35,250,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Foreground="#FF630808" FontSize="20" Height="32" Width="297" FontWeight="Bold" FontFamily="Yu Gothic UI Semibold"><Run Text="Введите "/><Run Text="им"/><Run Language="ru-ru" Text="я автора"/></TextBlock>
        <TextBox x:Name="TextBoxAuthorName" HorizontalAlignment="Left" Margin="247,255,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="190" Foreground="#FFE8DBDB" Height="22" Background="#FF630808" TextChanged="TextBoxAuthorName_TextChanged"/>
        <TextBlock HorizontalAlignment="Left" Margin="35,282,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Foreground="#FF630808" FontSize="20" FontWeight="Bold" FontFamily="Yu Gothic UI" Height="27" Width="159"><Run Language="ru-ru" Text="Введите логин"/></TextBlock>
        <TextBlock HorizontalAlignment="Left" Margin="35,314,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Foreground="#FF630808" FontSize="20" FontWeight="Bold" FontFamily="Yu Gothic UI" Height="27" Width="159"><Run Text="Введите "/><Run Language="ru-ru" Text="пароль"/></TextBlock>
        <TextBlock HorizontalAlignment="Left" Margin="35,349,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Foreground="#FF630808" FontSize="20" FontWeight="Bold" Width="204" FontFamily="Yu Gothic UI" Height="53"><Run Text="Введите "/><Run Language="ru-ru" Text="пароль повторно"/></TextBlock>
        <TextBlock HorizontalAlignment="Left" Margin="452,300,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Foreground="#FF630808" FontSize="20" FontWeight="Bold" Width="202" FontFamily="Yu Gothic UI" Height="28"><Run Language="ru-ru" Text="Дата рождения"/></TextBlock>
        <TextBlock HorizontalAlignment="Left" Margin="469,333,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Foreground="#FF630808" FontSize="20" FontWeight="Bold" RenderTransformOrigin="10.519,-8.578" FontFamily="Yu Gothic UI" Height="27" Width="61"><Run Language="ru-ru" Text="Стаж"/></TextBlock>
        <TextBox x:Name="TextBoxLogin" HorizontalAlignment="Left" Margin="247,288,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="190" Foreground="#FFEFE1E1"  Height="21" Background="#FF630808" />
        <PasswordBox x:Name="Passw1" HorizontalAlignment="Left" Margin="247,322,0,0" VerticalAlignment="Top" Width="190" Height="22" Background="#FF630804"/>
        <PasswordBox x:Name="Passw2" HorizontalAlignment="Left" Margin="247,354,0,0" VerticalAlignment="Top" Width="190" Height="22" Background="#FF630808"/>
        <DatePicker x:Name="DateB" HorizontalAlignment="Left" Margin="608,303,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5" Height="35" Width="176">
            <DatePicker.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="0.022"/>
                    <TranslateTransform/>
                </TransformGroup>
            </DatePicker.RenderTransform>
        </DatePicker>
        <TextBox x:Name="TextBoxStash" HorizontalAlignment="Left" Margin="607,345,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="133" RenderTransformOrigin="0.547,1.703" Height="18" Foreground="#FFECE0E0" Background="#FF630808">
            <TextBox.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="-0.147"/>
                    <TranslateTransform X="0.645" Y="-0.128"/>
                </TransformGroup>
            </TextBox.RenderTransform>
        </TextBox>
        <TextBlock HorizontalAlignment="Left" Margin="35,407,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Foreground="#FF630808" FontSize="20" Height="30" Width="297" FontWeight="Bold" FontFamily="Yu Gothic UI"><Run Text="Введите "/><Run Language="ru-ru" Text="почту"/></TextBlock>
        <TextBlock HorizontalAlignment="Left" Margin="35,442,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Foreground="#FF630808" FontSize="20" Height="31" Width="297" FontWeight="Bold" FontFamily="Yu Gothic UI"><Run Text="Введите "/><Run Language="ru-ru" Text="телефон"/></TextBlock>
        <TextBox x:Name="TextBoxEmail" HorizontalAlignment="Left" Margin="247,407,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="190" Foreground="#FFE8D4D4"  Height="30" Background="#FF630808"/>
        <TextBox x:Name="TextBoxPhone" HorizontalAlignment="Left" Margin="247,442,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="190" Foreground="#FFF1E7E7"  Height="32" Background="#FF630808"/>
        <Button x:Name="ButtonRegReg" Content="Зарегистрироваться" HorizontalAlignment="Left" Margin="516,397,0,0" VerticalAlignment="Top" Height="34" Width="212" Click="Button_Click" Foreground="#FF630808" FontSize="20" FontWeight="Bold" Background="White" FontFamily="Yu Gothic UI"/>
        <Button x:Name="ButtonNazad" Content="Назад" HorizontalAlignment="Left" Margin="563,449,0,0" VerticalAlignment="Top" Height="34" Width="118" Click="Button_Click_1" FontSize="20" Foreground="#FF630808" FontWeight="Bold" Background="White" FontFamily="Yu Gothic UI"/>
    </Grid>
</Page>
