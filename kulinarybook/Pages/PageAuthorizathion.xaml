<Page x:Class="kulinarybook.Pages.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:kulinarybook.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450"
      Title="Page1" Width="589">

    <Grid Margin="48,25,278,60">
        <Grid.Background>
            <ImageBrush Stretch="Fill" ImageSource="/Pages/i (2).png"/>
        </Grid.Background>
        <TextBlock HorizontalAlignment="Left" Margin="219,265,0,0" TextWrapping="Wrap" VerticalAlignment="Top"/>
        <TextBlock x:Name="___Без_имени_" HorizontalAlignment="Left" Margin="32,29,0,0" TextWrapping="Wrap" Text="Введите логин" VerticalAlignment="Top" Width="258" Height="23" Background="#FFEBECE6" FontFamily="Castellar" FontSize="16" Foreground="#FF941818"/>
        <TextBlock x:Name="___Без_имени__Копировать" HorizontalAlignment="Left" Margin="34,77,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="192" Height="15" Background="White" FontFamily="Castellar" FontSize="16" Foreground="#FF9C2828"><Run Text="Введите "/><Run Language="ru-ru" Text="пароль"/></TextBlock>
        <PasswordBox x:Name="password" HorizontalAlignment="Left" Height="17" Margin="32,101,0,0" VerticalAlignment="Top" Width="206" Background="#FF630808"/>
        <Button x:Name="buttonEnter" Content="ВОЙТИ" HorizontalAlignment="Left" Height="36" Margin="32,123,0,0" VerticalAlignment="Top" Width="206" Click="Button_Click" Background="#FF630808"/>
        <Button x:Name="Buttonreg" Content="ЗАРЕГИСТРИРОВАТЬСЯ" HorizontalAlignment="Left" Height="36" Margin="32,164,0,0" VerticalAlignment="Top" Width="206" Background="#FF630808" Click="Buttonreg_Click"/>
        <TextBox x:Name="textboxlogin" HorizontalAlignment="Left" Height="22" Margin="31,54,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="203" Background="#FF630808" TextChanged="textboxlogin_TextChanged" RenderTransformOrigin="0.5,0.5" Foreground="#FFFFF8F8">
            <TextBox.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="0.065"/>
                    <TranslateTransform/>
                </TransformGroup>
            </TextBox.RenderTransform>
        </TextBox>
    </Grid>
</Page>
